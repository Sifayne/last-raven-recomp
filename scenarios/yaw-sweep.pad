@2100  mark "sweep: left 127"
@2100  analog 1 128
@2160  analog center
@2180  mark "sweep: right 127"
@2180  analog 255 128
@2240  analog center
@2260  mark "sweep: left 96"
@2260  analog 32 128
@2320  analog center
