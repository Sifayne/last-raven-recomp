@2100  mark "probe: hard left (gameplay; the intro cutscene ends ~2050)"
@2100  analog 1 128
@2300  mark "probe: centre"
@2300  analog center
@2360  mark "probe: hard right"
@2360  analog 255 128
@2560  mark "probe: centre"
@2560  analog center
@2620  stop
