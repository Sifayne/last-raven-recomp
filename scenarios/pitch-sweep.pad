@2100  mark "pitch: right stick up 127"
@2100  analog 128 128 128 1
@2160  analog center
@2180  mark "pitch: right stick down 127"
@2180  analog 128 128 128 255
@2240  analog center
@2260  mark "pitch: right stick up 64"
@2260  analog 128 128 128 64
@2320  analog center
@2340  mark "pitch: mouse away from the player, 10 polls of 50 counts"
@2340  mouse 0 -50
@2341  mouse 0 -50
@2342  mouse 0 -50
@2343  mouse 0 -50
@2344  mouse 0 -50
@2345  mouse 0 -50
@2346  mouse 0 -50
@2347  mouse 0 -50
@2348  mouse 0 -50
@2349  mouse 0 -50
@2360  mark "pitch: mouse toward the player, 10 polls of 50 counts"
@2360  mouse 0 50
@2361  mouse 0 50
@2362  mouse 0 50
@2363  mouse 0 50
@2364  mouse 0 50
@2365  mouse 0 50
@2366  mouse 0 50
@2367  mouse 0 50
@2368  mouse 0 50
@2369  mouse 0 50
@2400  mark "pitch: triangle held -- the game's own digital look"
@2400  down triangle
@2460  up triangle
@2480  mark "pitch: circle held"
@2480  down circle
@2540  up circle
@2560  mark "pitch: triangle and circle together -- recentre, lockout"
@2560  down triangle,circle
@2570  up triangle,circle

@2600  stop
