# Boot to the title menu and stop. The fastest check that the harness works.
#
# circle skips the intro movie; the title screen then wants START, which is
# why circle alone parks there. Taps repeat because the exact poll the game
# becomes receptive at is not worth pinning -- a tap the game ignores costs
# one poll.

drain 200
minhold 4

  mark "circle: skip the intro movie"
  @50 tap circle
  @150 tap circle
  @250 tap circle
  @350 tap circle
  @450 tap circle
  @550 tap circle
  @650 tap circle
  @750 tap circle
  @850 tap circle
  @950 tap circle
  @1050 tap circle
  @1150 tap circle
  @1250 tap circle
  @1350 tap circle
  @1500 mark "start: title screen -> main menu"
  @1550 tap start
  @1650 tap start
  @1750 tap start
  @1850 tap start
  @1950 tap start
  @2050 tap start
  @2150 tap start
  @2250 tap start
  @2350 tap start
  @2450 mark "expect the CONVERT / NEW GAME / LOAD GAME menu"
  @2500 stop
