@2100  mark "walk-turn: walk forward only"
@2100  analog 128 1 128 128
@2160  analog center
@2180  mark "walk-turn: walk forward + right stick right"
@2180  analog 128 1 255 128
@2240  analog center
@2260  mark "walk-turn: walk forward + right stick left"
@2260  analog 128 1 1 128
@2320  analog center
@2340  mark "walk-turn: left stick diagonal forward-left"
@2340  analog 40 40 128 128
@2400  analog center
@2420  mark "walk-turn: walk back only"
@2420  analog 128 255 128 128
@2480  analog center
@2500  mark "walk-turn: turn only, right stick right"
@2500  analog 128 128 255 128
@2560  analog center

@2600  stop
