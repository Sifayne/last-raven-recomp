# Play -- into the first mission, then the pad is yours.
#
# mission-1.pad's prefix (the intro skipped, NEW GAME, the garage, the sortie),
# which reaches gameplay at about poll 2050; then `neutral` hands everything
# back to live input and the scenario ends without a `stop`. In a window that
# is an open-ended play session; headless, the drain bounds it. For trying a
# control scheme by hand:
#
#   scripts/09-replay.sh --window --decode --env PSPRECOMP_INPUT=dual \
#     --env PSPRECOMP_MOUSE=1 scenarios/play.pad
#
# Escape releases the mouse, a click takes it back, and closing the window
# ends the run with its summary.

drain 120
@76     state circle 128 128   # t=3.080s
@78     state none 128 128   # t=3.160s
@176    state circle 128 128   # t=7.458s
@178    state none 128 128   # t=7.553s
