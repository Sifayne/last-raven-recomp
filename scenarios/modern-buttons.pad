# Modern gamepad buttons -- exercise every semantic gameplay action.
#
# This follows mission-1.pad into live play, then sends the carrier bits used
# by host/present.c for A/B/X/Y, the bumpers, triggers and stick clicks.  With
# PSPRECOMP_INPUT_LOG, host/replacements.c records both each carrier edge and
# every matching game action actually queried while it is active:
#
#   scripts/09-replay.sh --decode --env PSPRECOMP_INPUT=dual \
#     --env PSPRECOMP_INPUT_LOG=reports/modern-buttons.log \
#     scenarios/modern-buttons.pad
#   grep -E 'pad extra|semantic-' reports/modern-buttons.log
#
# X is intentionally spare in gameplay, so it should produce a carrier line
# and no semantic-action line.  Y is the disarmament modifier and is paired
# with RT at the end so the game traverses the purge path.  Inside, extension
# and OB/EO are only queried when the corresponding parts are equipped; the
# starter AC therefore proves their carrier edges, not their action calls.
# The bumper checks are also a movement regression: LB/RB must report actions
# 7/4, never the strafe actions 8/9, and must produce no centred-stick push.

drain 500

@76     state circle 128 128   # t=3.080s
@78     state none 128 128   # t=3.160s
@176    state circle 128 128   # t=7.458s
@178    state none 128 128   # t=7.553s
@317    state circle 128 128   # t=13.327s
@318    state none 128 128   # t=13.379s
@331    state start 128 128   # t=14.028s
@333    state none 128 128   # t=14.135s
@359    state cross 128 128   # t=15.475s
@361    state none 128 128   # t=15.567s
@409    state circle 128 128   # t=18.664s
@411    state none 128 128   # t=18.800s
@439    state down 128 128   # t=20.530s
@440    state none 128 128   # t=20.593s
@442    state down 128 128   # t=20.718s
@444    state none 128 128   # t=20.826s
@446    state cross 128 128   # t=20.951s
@448    state none 128 128   # t=21.082s
@474    state start 128 128   # t=23.119s
@475    state none 128 128   # t=23.208s
@484    state cross 128 128   # t=24.001s
@485    state none 128 128   # t=24.091s
@496    state cross 128 128   # t=25.017s
@498    state none 128 128   # t=25.184s
@501    state down 128 128   # t=25.436s
@502    state none 128 128   # t=25.520s
@503    state down 128 128   # t=25.604s
@504    state none 128 128   # t=25.672s
@505    state down 128 128   # t=25.757s
@506    state none 128 128   # t=25.842s
@507    state down 128 128   # t=25.926s
@508    state none 128 128   # t=26.010s
@509    state down 128 128   # t=26.094s
@511    state none 128 128   # t=26.245s
@512    state down 128 128   # t=26.329s
@513    state none 128 128   # t=26.413s
@515    state down 128 128   # t=26.581s
@516    state none 128 128   # t=26.648s
@519    state right 128 128   # t=26.900s
@520    state none 128 128   # t=26.984s
@521    state right 128 128   # t=27.067s
@522    state none 128 128   # t=27.151s
@523    state right 128 128   # t=27.234s
@524    state none 128 128   # t=27.318s
@525    state right 128 128   # t=27.403s
@527    state none 128 128   # t=27.572s
@528    state right 128 128   # t=27.640s
@529    state none 128 128   # t=27.724s
@530    state right 128 128   # t=27.807s
@531    state none 128 128   # t=27.892s
@532    state right 128 128   # t=27.975s
@534    state none 128 128   # t=28.144s
@539    state cross 128 128   # t=28.564s
@541    state none 128 128   # t=28.725s
@554    state cross 128 128   # t=29.917s
@556    state none 128 128   # t=30.105s
@623    state start 128 128   # t=34.010s
@626    state none 128 128   # t=34.135s
@640    state circle 128 128   # t=34.759s
@642    state none 128 128   # t=34.853s
@733    state circle 128 128   # t=39.075s
@735    state none 128 128   # t=39.222s
@751    state down 128 128   # t=40.234s
@752    state none 128 128   # t=40.297s
@778    state cross 128 128   # t=41.900s
@781    state none 128 128   # t=42.079s
@817    state cross 128 128   # t=44.676s
@818    state none 128 128   # t=44.769s
@849    state cross 128 128   # t=47.916s
@850    state none 128 128   # t=48.025s
@863    state triangle 128 128   # t=49.218s
@864    state none 128 128   # t=49.333s
@876    state left 128 128   # t=50.540s
@878    state none 128 128   # t=50.749s
@881    state cross 128 128   # t=51.061s
@882    state none 128 128   # t=51.139s
@1698   state circle 128 128   # t=106.511s
@1699   state none 128 128   # t=106.589s
@1715   state circle 128 128   # t=107.848s
@1716   state none 128 128   # t=107.935s

@2020   mark "pitch away from centre before the view-reset check"
@2020   analog 128 128 128 1
@2038   analog center
@2040   mark "modern gameplay buttons"
@2040   state 0x00000800 128 128   # B: view reset (action 12)
@2050   state none 128 128
@2060   state 0x00000400 128 128   # A: inside (action 14)
@2070   state none 128 128
@2080   state 0x01000000 128 128   # L3: extension (action 13)
@2090   state none 128 128
@2100   state 0x00100000 128 128   # LB: left arm / event (action 7)
@2110   state none 128 128
                                                # let the starter blade animation finish
@2140   state 0x00800000 128 128   # RT: right arm (action 6)
@2150   state none 128 128
@2160   state 0x00400000 128 128   # LT: boost (action 5)
@2170   state none 128 128
@2180   state 0x00200000 128 128   # RB: change weapon (action 4)
@2190   state none 128 128
@2200   state 0x02000000 128 128   # R3: OB / EO (action 15)
@2210   state none 128 128
@2220   state 0x00040000 128 128   # X: intentionally spare
@2230   state none 128 128
@2240   state 0x00880000 128 128   # Y + RT: purge modifier + right arm
@2250   state none 128 128

@2280   stop
