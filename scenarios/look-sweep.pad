# Dual-stick look -- the right stick turns, the mouse turns, the left stick
# strafes. Headless proof of the look channel: everything here reaches the
# game through the sceCtrl lanes, so a replay reproduces it.
#
# mission-1.pad's prefix into the first mission (gameplay from ~poll 2050),
# then holds of the RIGHT stick at 127 and 64 each way, a mouse drag of 40
# polls at -30 and then +30 counts a poll, and a LEFT stick push that must
# strafe and not rotate.
#
#   scripts/09-replay.sh --decode --env PSPRECOMP_INPUT=dual \
#     --env PSPRECOMP_VIEW_LOG=reports/look-sweep.view \
#     --env PSPRECOMP_VIEW_LOG_WORLD=all \
#     --env PSPRECOMP_VIEW_LOG_POLLS=2130-2135,2210-2215,2290-2295,2370-2375,2440-2445,2500-2505,2570-2575 \
#     scenarios/look-sweep.pad
#   scripts/view-analyze.py reports/look-sweep.view --deltas
#
# Expected, at 2.1019 deg/frame for a full stick and 0.001 rad per mouse
# count: right 127 -> -2.10 (the analyzer's yaw grows for a left turn), left
# 127 -> +2.10, +/-64 -> 1.06, the drags -> +/-1.72 per poll, the strafe -> 0.

drain 500

@76     state circle 128 128   # t=3.080s
@78     state none 128 128   # t=3.160s
@176    state circle 128 128   # t=7.458s
@178    state none 128 128   # t=7.553s
@317    state circle 128 128   # t=13.327s
@318    state none 128 128   # t=13.379s
@331    state start 128 128   # t=14.028s
@333    state none 128 128   # t=14.135s
