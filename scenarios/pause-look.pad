@1716   state none 128 128   # t=107.935s


@2050  mark "play: the pad is ours"
@2100  mark "in play: right stick right"
@2100  analog 128 128 255 128
@2130  analog center
@2160  mark "Start: pause menu"
@2160  tap start 2
@2180  mark "paused: right stick right -- nothing may move"
@2180  analog 128 128 255 128
@2240  analog center
@2250  mark "paused: mouse right, 10 polls of 50 counts"
@2250  mouse 50 0
@2251  mouse 50 0
@2252  mouse 50 0
@2253  mouse 50 0
@2254  mouse 50 0
@2255  mouse 50 0
@2256  mouse 50 0
@2257  mouse 50 0
@2258  mouse 50 0
@2259  mouse 50 0
@2280  mark "paused: left stick left"
@2280  analog 1 128
@2320  analog center
@2340  mark "Start: back to play"
@2340  tap start 2
@2360  mark "in play again: right stick right"
@2360  analog 128 128 255 128
@2420  analog center
@2450  stop
