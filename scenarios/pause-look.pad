@511    state none 128 128   # t=26.245s
@512    state down 128 128   # t=26.329s
@513    state none 128 128   # t=26.413s
@515    state down 128 128   # t=26.581s
@516    state none 128 128   # t=26.648s
@519    state right 128 128   # t=26.900s
@520    state none 128 128   # t=26.984s
@521    state right 128 128   # t=27.067s
@522    state none 128 128   # t=27.151s
@523    state right 128 128   # t=27.234s
@524    state none 128 128   # t=27.318s
@525    state right 128 128   # t=27.403s
@527    state none 128 128   # t=27.572s
@528    state right 128 128   # t=27.640s
@529    state none 128 128   # t=27.724s
@530    state right 128 128   # t=27.807s
@531    state none 128 128   # t=27.892s
@532    state right 128 128   # t=27.975s
@534    state none 128 128   # t=28.144s
@539    state cross 128 128   # t=28.564s
@541    state none 128 128   # t=28.725s
@554    state cross 128 128   # t=29.917s
@556    state none 128 128   # t=30.105s
@623    state start 128 128   # t=34.010s
@626    state none 128 128   # t=34.135s
@640    state circle 128 128   # t=34.759s
@642    state none 128 128   # t=34.853s
@733    state circle 128 128   # t=39.075s
