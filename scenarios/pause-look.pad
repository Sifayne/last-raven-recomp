# Pause and look -- the look channel must be inert in the pause menu.
#
# mission-1.pad's prefix into the first mission (gameplay from ~poll 2050),
#
# mission-1.pad's prefix into the first mission (gameplay from ~poll 2050),
# then: a right-stick yaw in play, Start to open the pause menu, and in the
# menu the same right-stick hold, a mouse drag and a left-stick hold -- none
# of which may turn the AC or drive the menu -- then Start again and one more
# yaw hold to show play resumed. With PSPRECOMP_INPUT_LOG the converter
# (host/replacements.c) writes `play=0/1` on every transition of its gate, and
# the yaw integrator its rate every frame it runs:
#
#   scripts/09-replay.sh --decode --env PSPRECOMP_INPUT=dual --env PSPRECOMP_MOUSE=1 \
#     --env PSPRECOMP_INPUT_LOG=reports/pause-look.log scenarios/pause-look.pad
#   grep -E 'play=| ac=' reports/pause-look.log | awk '$1>=2090' | uniq -c -f1
#
# Expected: play=1 from the mission's start; yaw at 2100-2130; play=0 at the
# poll after Start; no yaw lines at all between; play=1 after the second
# Start; yaw at 2360-2420.

drain 500

@76     state circle 128 128   # t=3.080s
@78     state none 128 128   # t=3.160s
@176    state circle 128 128   # t=7.458s
@178    state none 128 128   # t=7.553s
@317    state circle 128 128   # t=13.327s
@318    state none 128 128   # t=13.379s
@331    state start 128 128   # t=14.028s
@333    state none 128 128   # t=14.135s
@359    state cross 128 128   # t=15.475s
@361    state none 128 128   # t=15.567s
@409    state circle 128 128   # t=18.664s
@411    state none 128 128   # t=18.800s
@439    state down 128 128   # t=20.530s
@440    state none 128 128   # t=20.593s
@442    state down 128 128   # t=20.718s
@444    state none 128 128   # t=20.826s
@446    state cross 128 128   # t=20.951s
@448    state none 128 128   # t=21.082s
@474    state start 128 128   # t=23.119s
@475    state none 128 128   # t=23.208s
@484    state cross 128 128   # t=24.001s
@485    state none 128 128   # t=24.091s
@496    state cross 128 128   # t=25.017s
@498    state none 128 128   # t=25.184s
@501    state down 128 128   # t=25.436s
@502    state none 128 128   # t=25.520s
