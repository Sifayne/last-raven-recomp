# ---------------------------------------------------------------------------
# GATING RULE: this repository ships CODE ONLY.
#
# No game data, no firmware, no decryption keys, no extracted assets — ever.
# The user supplies their own dump of media they own. If you are adding a
# pattern here, add it BEFORE the file it matches exists on disk.
# ---------------------------------------------------------------------------

# --- Game dumps and containers ---------------------------------------------
game/
/games/
*.iso
*.cso
*.dax
*.chd
*.pbp
*.PBP
*.prx
*.PRX
*.elf
*.bin
*.BIN
*.img
*.umd
EBOOT.*
BOOT.*
PSP_GAME/
UMD_DATA.BIN

# --- Decryption keys and firmware ------------------------------------------
# psp_keys.txt is the real thing; the .example.txt from psprecomp is fine.
keys/
psp_keys.txt
*.key
*.keys
!*.example.txt

# --- Extracted / generated game-derived content -----------------------------
# Recompiled C is a derivative of the binary — regenerate it, never commit it.
generated/
extracted/
out/
*.gcm
*.vag
*.at3
*.gim
*.tga

# --- Analysis output --------------------------------------------------------
# reports/ holds raw dumps (disassembly, symbol tables) that embed game code.
# Committed summaries live in docs/findings/ instead, hand-curated.
reports/*
!reports/.gitkeep

# The Memory Stick of a direct run. ms0: resolves to <working directory>/ms;
# the launcher runs the game from ~/.local/share/last-raven/saves/<slug>
# (docs/SAVE-SYNC.md), but a bare scripts/06-boot.sh run lands here -- a real
# save is 250K of save data, icon and background, and it is the player's, not
# ours. Same rule as game/: media and save data never enter the repository.
ms/

# --- Build ------------------------------------------------------------------
build/
cmake-build-*/
compile_commands.json
.cache/

# --- Editor / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
__pycache__/
*.py[cod]
frame.ppm
frame.ppm*
reports/seq/
# pspautotests write their results through host0:, which iofilemgr resolves
# relative to the working directory. 07-autotests.sh runs them from
# reports/hostfs/ (already ignored); these catch a run started by hand from
# the repo root, which would otherwise drop them into host/ next to boot.c.
__testoutput.txt
__testerror.txt
__testfinish.txt
host/__test*.txt

# GE captures: guest memory images, tens of megabytes, and game data
*.gcap

# Local credentials and agent state are not project sources.
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
.claude/
.codex/

# Additional extracted media and player data.
*.pmf
*.pkb
*.pkh
*.sgb
*.wav
*.ppm
*.SFO
*.sfo
