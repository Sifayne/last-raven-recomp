-        g_in_callback = 1;
         psp_cpu.r[PSP_REG_A0] = count;
         psp_cpu.r[PSP_REG_A1] = arg;
         psp_cpu.r[PSP_REG_A2] = common;
         psp_cpu.r[PSP_REG_RA] = 0;
