+     * because the comparison is unsigned. */
+    uint32_t prio = psp_arg(1);
+    if (prio == 0) prio = psp_threadman_current_priority();
+    else if (prio < 0x08u || prio > 0x77u) {
+        psp_ret(SCE_KERNEL_ERROR_ILLEGAL_PRIORITY);
+        return;
+    }
+    t->priority = prio;
