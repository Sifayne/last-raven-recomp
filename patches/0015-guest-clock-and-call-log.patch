+    uint32_t r = (uint32_t)( p        & 0x1F); r = (r << 3) | (r >> 2);
+    uint32_t g = (uint32_t)((p >>  5) & 0x3F); g = (g << 2) | (g >> 4);
+    uint32_t b = (uint32_t)((p >> 11) & 0x1F); b = (b << 3) | (b >> 2);
+    return 0xFF000000u | (b << 16) | (g << 8) | r;
