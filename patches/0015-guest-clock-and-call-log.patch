+    if (!n) { fprintf(out, "  (no firmware calls)\n"); return; }
+    if (top > n) top = n;
+    for (int i = 0; i < top; i++) {
+        const int e = order[i];
+        fprintf(out, "  %10llu  %s\n", (unsigned long long)g_calls[e],
+                g_entry[e].name ? g_entry[e].name : "(unnamed)");
+    }
+    if (g_calls_unimpl)
+        fprintf(out, "  %10llu  (unimplemented)\n",
