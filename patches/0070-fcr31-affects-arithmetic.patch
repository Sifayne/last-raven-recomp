index 2148b75..b2f2e1b 100644
--- a/include/psprecomp/recomp_rt.h
+++ b/include/psprecomp/recomp_rt.h
@@ -342,6 +342,163 @@ static inline uint32_t psp_f32_to_i32(float v, int rm) {
     return (uint32_t)(int32_t)r;
