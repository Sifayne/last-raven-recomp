+            fprintf(f, "%spsp_vimm(%u, (float)NAN);\n", ind, in->vt);
         else
-            fprintf(f, "%spsp_vimm(%u, %#.9gf);\n", ind, in->vd, (double)v);
+            fprintf(f, "%spsp_vimm(%u, %#.9gf);\n", ind, in->vt, (double)v);
         return;
     }
 
