+ * have -- all fifteen of try.expected's, where try600.expected gives the
+ * specific code for the same inputs. */
+#define SCE_KERNEL_ERROR_LWMUTEX_TRY_FAILED      0x800201C4
+
 /* ---- the subsystems ------------------------------------------------------ */
 
