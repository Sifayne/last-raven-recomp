+    int bad = 0;
+    for (int j = 0; j < 16 && bad < 4; j++)
+        for (int k = 0; k < 16 && bad < 4; k++) {
+            const uint32_t got  = pixel(40 + k, 30 + j);
+            const uint32_t want = ramp_texel(3 * k + 1, 3 * j + 1);
