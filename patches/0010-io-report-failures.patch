+            fprintf(stderr, "%s\"\n", size > 200 ? "..." : "");
+        }
+        psp_ret(0x80020323);
+        return;
+    }
 
     uint8_t *tmp = (uint8_t *)malloc(size ? size : 1);
     if (!tmp) { psp_ret(0x80020190); return; }
