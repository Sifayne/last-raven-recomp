+    if (u < g_ge.u_lo) g_ge.u_lo = u;
+    if (u > g_ge.u_hi) g_ge.u_hi = u;
+    if (v < g_ge.v_lo) g_ge.v_lo = v;
+    if (v > g_ge.v_hi) g_ge.v_hi = v;
