-    if (!c) { psp_ret(SCE_KERNEL_ERROR_UNKNOWN_CBID); return; }
+uint32_t psp_threadman_notify_callback(uint32_t cbid, uint32_t arg) {
+    psp_callback *c = find_cb(cbid);
