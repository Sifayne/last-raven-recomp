+static void wait_writeback(uint32_t tmo_ptr, uint64_t deadline) {
+    if (!tmo_ptr) return;
+    const uint64_t now = psp_clock_peek();
+    psp_write32(tmo_ptr, now < deadline ? (uint32_t)(deadline - now) : 0);
