 }
 
-void psp_threadman_init(void) { psp_threadman_reset(); }
+static void on_thread_end(uint32_t uid, uint32_t status);
+
+void psp_threadman_init(void) {
+    psp_sched_set_end_hook(on_thread_end);
+    psp_threadman_reset();
