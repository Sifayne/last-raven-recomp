+                r = 0.0f;                                   /* zero, denormal, either sign */
+            else if (b >> 31)
+                r = psp_bits_to_f32(0x7F800001u);           /* negative -> NaN */
+            else if ((b >> 23) == 255u)
+                r = psp_bits_to_f32(0x7F800000u + ((b & 0x007FFFFFu) != 0u));
+            else
+                r = psp_fsqrt(a);
+            break;
+        }
+        case PSP_VU_RSQ: {
