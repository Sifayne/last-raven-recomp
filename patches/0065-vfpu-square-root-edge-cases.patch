+            else if (b >> 31)
+                r = psp_bits_to_f32(0xFF800001u);           /* negative -> negative NaN */
+            else if ((b >> 23) == 255u)
+                r = psp_bits_to_f32((b & 0x007FFFFFu) ? 0x7F800001u : 0u); /* inf -> 0 */
+            else
+                r = 1.0f / psp_fsqrt(a);
+            break;
+        }
